# Firebase 設定（Spark プラン・無料）
# Firebase Console > プロジェクト設定 > ウェブアプリ からコピー
# このファイルを .env にコピーして値を設定してください
# .env はgit管理対象外です（.gitignore 参照）

VITE_FB_API_KEY=your-api-key
VITE_FB_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FB_PROJECT_ID=your-project-id
VITE_FB_STORAGE_BUCKET=your-project.appspot.com
VITE_FB_MESSAGING_SENDER_ID=123456789
VITE_FB_APP_ID=1:123456789:web:abcdef
